%% 2.2.2 Preparar o cliente: desativar o SSSD e ativar o Winbind
flowchart TB
    subgraph CL["Cliente Winbind - clone do template UbuntuClient"]
        A["SSSD - desativado (2.2.2)<br/>sssd, pam_sss, NSS sss"]:::net
        B["Winbind - ativado (2.2.2)<br/>winbind, pam_winbind, NSS winbind"]:::svc
        P["PAM e NSS do cliente"]:::svc
    end
    A -.->|"desligado"| P
    B --> P
    classDef vm fill:#e8eef7,stroke:#1f497d,stroke-width:2px,color:#000
    classDef svc fill:#ffffff,stroke:#1f497d,stroke-width:1px,color:#000
    classDef net fill:#f3f3f3,stroke:#777,stroke-dasharray:4 3,color:#000